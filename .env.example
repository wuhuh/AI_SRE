# Agent Runtime LLM 配置
# 设置为 openai 后，Agent 会调用真实 OpenAI-compatible API
LLM_PROVIDER=openai
AUTO_CONSUME=true

# DeepSeek V4 Flash / opencode 兼容端点
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=deepseek-v4-flash

# 从 opencode / API 提供方获取
OPENAI_API_KEY=your-api-key-here

# Control Plane RBAC 用户（开发默认值）
AISRE_ADMIN_USER=admin
AISRE_ADMIN_PASSWORD=admin
AISRE_OPERATOR_USER=operator
AISRE_OPERATOR_PASSWORD=operator
AISRE_VIEWER_USER=viewer
AISRE_VIEWER_PASSWORD=viewer