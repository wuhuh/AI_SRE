# Agent Runtime LLM 配置
# 设置为 openai 后，Agent 会调用真实 OpenAI-compatible API
LLM_PROVIDER=openai
AUTO_CONSUME=true

# DeepSeek V4 Flash / opencode 兼容端点
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=deepseek-v4-flash

# 从 opencode / API 提供方获取
OPENAI_API_KEY=your-api-key-here

# Control Plane RBAC 用户
# P0-06: strict 模式（compose 默认开启）下默认口令 admin/operator/viewer 会拒绝启动，
# 请改成自己的值；支持明文或 BCrypt 哈希（$2 开头）。
AISRE_ADMIN_USER=admin
AISRE_ADMIN_PASSWORD=change-me-admin
AISRE_OPERATOR_USER=operator
AISRE_OPERATOR_PASSWORD=change-me-operator
AISRE_VIEWER_USER=viewer
AISRE_VIEWER_PASSWORD=change-me-viewer

# P0-06: JWT 签名密钥（>=32 字节；生成：openssl rand -base64 32）
AISRE_JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes-long

# P0-05: Agent 回调共享 token（agent-runtime 的 AGENT_TOKEN 必须同值）
AISRE_AGENT_TOKEN=change-me-agent-token

# P0-04: 审批执行 token（control-plane 与 tool-server 必须同值）
AISRE_TOOL_SERVER_TOKEN=change-me-execution-token
# strict=true 时拒绝默认密钥/默认口令启动（compose 已默认开启）
AISRE_SECURITY_STRICT=true